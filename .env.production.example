POSTGRES_DB=social_network
POSTGRES_USER=social_network
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Web 进程数与算法并发数：2核4G 主机用 2/2，4核8G 可升回 3/4
GUNICORN_WORKERS=2
CELERY_CONCURRENCY=2
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=sna.example.edu.cn
DJANGO_CSRF_TRUSTED_ORIGINS=https://sna.example.edu.cn
DJANGO_SECURE_SSL=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_TRUST_PROXY_HEADERS=1
DJANGO_NUM_PROXIES=1
PUBLIC_STANDARD_ALGORITHM_RATE=120/hour
PUBLIC_HEAVY_ALGORITHM_RATE=30/hour
PUBLIC_OPERATION_RATE=240/hour
TEACHER_LOGIN_ATTEMPTS=5
TEACHER_LOGIN_WINDOW_SECONDS=900
RUN_LEASE_SECONDS=900
RUN_HEARTBEAT_SECONDS=30
PENDING_DELIVERY_SECONDS=120
RUN_MONITOR_SECONDS=1
# 只用于算法的一次性隔离子进程；不会终止可复用的 Celery worker。
RUN_CHILD_TERMINATE_GRACE_SECONDS=5
MAX_UPLOAD_BYTES=20971520
PUBLIC_MAX_NODES=2000
PUBLIC_MAX_EDGES=20000
